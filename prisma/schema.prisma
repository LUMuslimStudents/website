generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model users {
  id            BigInt    @id @unique(map: "id") @default(autoincrement()) @db.UnsignedBigInt
  first_name    String    @db.VarChar(50)
  last_name     String    @db.VarChar(50)
  password      String    @db.VarChar(100)
  email         String    @unique(map: "email") @db.VarChar(50)
  role          Role      @default(user)
  gender        Gender
  study_program String    @db.VarChar(50)
  phone_number  String    @unique(map: "phone_number") @db.VarChar(15)
  term          String    @db.VarChar(4)
  created_at    DateTime? @default(now()) @db.DateTime(0)
}

model pending_signups {
  id                           String    @id @default(cuid())
  first_name                   String    @db.VarChar(50)
  last_name                    String    @db.VarChar(50)
  email                        String    @unique(map: "email") @db.VarChar(50)
  phone_number                 String    @unique(map: "phone_number") @db.VarChar(15)
  password                     String    @db.VarChar(100)
  study_program                String    @db.VarChar(50)
  verifications_completed      Json
  email_verification_code      String?   @db.VarChar(6)
  email_verification_expires   DateTime?
  email_verified_at            DateTime?

  payment_verification_code    String?   @db.VarChar(50)
  payment_verification_expires DateTime?
  payment_verified_at          DateTime?
  created_at                   DateTime  @default(now())
  expires_at                   DateTime  @db.DateTime(0)
  gender                       Gender
}

enum Role {
  user
  admin
}

enum Gender {
  male
  female
}
