generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("SUPABASE_URL")
  directUrl = env("DIRECT_SB_URL")
}

// ──────────────────────────────────────────────────────────────────────────────
// This Prisma schema is the SOURCE OF TRUTH for the public schema in Supabase.
// Apply changes via `prisma db push` or create a SQL migration in supabase/sql/.
// For auth schema (auth.users), RLS policies, and Edge Functions:
//   → see supabase/README.md
// ──────────────────────────────────────────────────────────────────────────────

model users {
  // Mirrors auth.users.id (UUID). FK is created in supabase/sql/setup.sql
  id            String    @id @db.Uuid
  first_name    String    @db.VarChar(50)
  last_name     String    @db.VarChar(50)
  phone_number  String    @unique @db.VarChar(15)
  role          Role      @default(user)
  gender        Gender
  study_program String    @db.VarChar(50)
  term          String    @db.VarChar(4)

  registrations event_registrations[]
  membership_payments membership_payments[]
  transactions transactions[]
}

model events_info {
  id              Int          @id @default(autoincrement())
  term            String       @db.VarChar(4)
  title           String       @db.VarChar(50)
  date            DateTime     @db.Date
  start_time      DateTime     @db.Time(0)
  end_time        DateTime     @db.Time(0)
  deadline        DateTime     @db.Timestamp(0)
  address         String       @db.VarChar(50)
  invitation      Invitation   @default(members)
  siblings        Siblings     @default(all)
  price_member    Int          @default(0)
  price_nonmember Int          @default(-1)
  price_alumnus   Int          @default(-1)
  description     String?      @db.Text
  poster          String?      @db.VarChar(255)
  is_published    Boolean      @default(true)
  is_open         Boolean      @default(true)
  registrations   event_registrations[]
  form_fields     event_form_fields[]
}

model event_registrations {
  id                  String                    @id @default(cuid())
  event_id            Int
  user_id             String?                   @db.Uuid
  status              EventRegistrationStatus   @default(pending)
  invitation_snapshot Invitation
  siblings_snapshot   Siblings
  quoted_price        Int
  payment_required    Boolean                   @default(false)
  transaction_id      String?                   @unique @db.Uuid
  submitted_at        DateTime                  @default(now())
  updated_at          DateTime                  @updatedAt

  user                users?                    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  event               events_info               @relation(fields: [event_id], references: [id], onDelete: Cascade)
  transaction         transactions?             @relation(fields: [transaction_id], references: [id], onDelete: SetNull)
  profile             event_registration_profiles?
  answers             event_registration_field_answers[]

  @@index([event_id, status, submitted_at])
  @@index([user_id])
  @@unique([event_id, user_id], map: "uniq_member_registration_per_event")
}

model event_registration_profiles {
  registration_id String                @id
  first_name      String                @db.VarChar(50)
  last_name       String                @db.VarChar(50)
  email           String                @db.VarChar(50)
  phone_number    String                @db.VarChar(15)
  gender          Gender
  is_student      Boolean
  university_name String                @db.VarChar(100)
  study_program   String?               @db.VarChar(100)
  is_alumnus      Boolean

  registration    event_registrations   @relation(fields: [registration_id], references: [id], onDelete: Cascade)

  @@index([email, phone_number])
  @@unique([email, phone_number, registration_id], map: "uniq_profile_email_phone_registration")
}

model event_form_fields {
  id           String                      @id @default(cuid())
  event_id     Int
  question     String                      @db.VarChar(255)
  help_text    String?                     @db.VarChar(500)
  field_type   EventFormFieldType
  is_required  Boolean                     @default(false)
  sort_order   Int                         @default(0)
  options      Json?
  created_at   DateTime                    @default(now())
  updated_at   DateTime                    @updatedAt

  event        events_info                 @relation(fields: [event_id], references: [id], onDelete: Cascade)
  answers      event_registration_field_answers[]

  @@index([event_id, sort_order])
}

model event_registration_field_answers {
  id                      String                @id @default(cuid())
  registration_id         String
  field_id                String
  answer_payload          Json
  field_type_snapshot     EventFormFieldType
  field_question_snapshot String                @db.VarChar(255)
  created_at              DateTime              @default(now())

  registration            event_registrations   @relation(fields: [registration_id], references: [id], onDelete: Cascade)
  field                   event_form_fields     @relation(fields: [field_id], references: [id], onDelete: Cascade)

  @@index([registration_id])
  @@index([field_id])
  @@unique([registration_id, field_id], map: "uniq_registration_answer_per_field")
}

model admin_options {
  term                          String    @id @db.VarChar(4)
  price_single_term             Int       @default(150)
  price_discounted_two_term     Int       @default(300)
  membership_open               Boolean   @default(true)
  is_current                    Boolean   @default(false)
}

model membership_payments {
  id             String         @id @default(cuid())
  user_id        String         @db.Uuid
  term           String         @db.VarChar(4)
  plan           MembershipPlan
  transaction_id String?        @unique @db.Uuid
  created_at     DateTime       @default(now())

  user           users          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transaction    transactions?  @relation(fields: [transaction_id], references: [id], onDelete: SetNull)

  @@index([user_id, term])
}

model transactions {
  id                String            @id @db.Uuid
  user_id           String?           @db.Uuid
  source            TransactionSource
  term              String            @db.VarChar(4)
  amount            Int
  currency          String            @default("sek") @db.VarChar(3)
  stripe_session_id String?           @unique @db.VarChar(255)
  payment_status    PaymentStatus     @default(unpaid)
  paid_at           DateTime?         @db.Timestamptz(6)
  created_at        DateTime          @default(now())

  user              users?            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  event_registration event_registrations?
  membership_payment membership_payments?

  @@index([user_id])
  @@index([source, term])
}

enum Role {
  user
  admin
}

enum Gender {
  male
  female
}

enum Invitation {
  members
  non_members
  alumni
  all_students
  non_students
}

enum Siblings {
  brothers
  sisters
  all
}

enum EventRegistrationStatus {
  pending
  confirmed
  cancelled
  waitlisted
}

enum EventFormFieldType {
  short_text
  checkbox_multi
  radio_single
}

enum PaymentStatus {
  unpaid
  paid
  refunded
  failed
}

enum TransactionSource {
  event
  membership
  donation
}

enum MembershipPlan {
  single_term
  two_term
}
